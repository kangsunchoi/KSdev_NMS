# ============================================================================
# NetVision OT — backend/.env  추가 설정 예시
# ----------------------------------------------------------------------------
# 이 파일(.env.example)은 안전한 플레이스홀더입니다. 실제 값은 VM의 backend/.env
# 에만 넣으세요 (backend/.env 는 .gitignore 로 커밋되지 않습니다).
#
# 아래 신규 항목은 전부 "기본 OFF" 입니다. 아무것도 추가하지 않고 배포하면
# 기존 동작과 100% 동일하게 돕니다. 필요할 때 하나씩 켜세요.
# ============================================================================

# --- 기존 항목 (참고) -------------------------------------------------------
MONGO_URL="mongodb://localhost:27017"
DB_NAME="netvision"
# 대시보드 주소(쉼표로 여러 개). 미설정 시 "*"(모든 출처 허용, 자격증명 불허).
# AUTH_ENABLED=true 라면 반드시 실제 대시보드 주소로 지정 (issue #8).
CORS_ORIGINS="http://192.168.108.129:8080"
SIMULATION_MODE=true

# --- 인증 / RBAC (기본 OFF) --------------------------------------------------
# 매 요청마다 사용자 역할·존재 여부를 DB에서 확인(#49). 프로세스 내 캐시 초(기본 5).
# 역할 변경·삭제·비밀번호 변경은 같은 프로세스에서 즉시, 다중 워커면 최대 이 시간 뒤 반영.
# AUTH_USER_CACHE_SEC=5
# true 로 바꾸면 로그인 + 권한제어가 켜집니다. (viewer < operator < admin)
AUTH_ENABLED=false
# 인증을 켤 때 반드시 설정 (없으면 재시작마다 로그인이 풀립니다).
# 생성 예: python3 -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
# 첫 시작 시 만들어지는 관리자 계정 (AUTH_ENABLED=true 이고 사용자가 없을 때만)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
# 로그인 토큰 유효시간(시간)
AUTH_TOKEN_TTL_HOURS=12

# --- 수집 API 보호 (기본 OFF) -----------------------------------------------
# 값을 넣으면 /api/ingest, /api/metrics, /api/interfaces, /api/links,
# /api/discovery/register, /api/fdb, /api/assets, /api/arp 가 X-Ingest-Token 헤더를 요구합니다.
# (켜면 Node-RED 플로우의 HTTP 노드에도 같은 헤더를 추가해야 합니다.)
# 로그인(AUTH_ENABLED=true)을 켜려면 INGEST_TOKEN도 반드시 설정하세요. Node-RED가
# GET /api/devices, GET·PUT /api/discovery, PATCH /api/devices/{id} 를 이 토큰으로 호출합니다.
# 토큰을 설정하면 화면(Discovery)에는 SNMP community가 마스킹되어 보입니다.
INGEST_TOKEN=

# --- 감사 추적 (기본 ON, 비침습) --------------------------------------------
AUDIT_ENABLED=true
AUDIT_TTL_DAYS=30

# --- 알람 상관관계 RCA (기본 ON, 비침습 주석만) -----------------------------
RCA_ENABLED=true

# --- 알람 통지 (기본 OFF: 아래 값이 비어있으면 발송 안 함) -------------------
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 통지 최소 심각도: info | warning | critical
NOTIFY_MIN_SEVERITY=critical

# --- 감시 정확도 (스프린트 2) ------------------------------------------------
# 실데이터 모드에서 이 시간(초) 동안 데이터가 없으면 장비를 offline + "수집 중단" 알람.
# 0이면 끔. 기본 180초 = 30초 주기 ping 플로우 6회 누락.
STALE_AFTER_SEC=180
# 확인/해소된 알람 보관 기간(일). (이전: 2시간 뒤 삭제)
ALERT_RETENTION_DAYS=30
# 알림 폭주 방지: 분당 최대 발송 수
NOTIFY_MAX_PER_MIN=20

# 수집 요청이 몰려도 화면 갱신은 이 간격(초)당 최대 1회로 묶음
BROADCAST_DEBOUNCE_SEC=1.0
# 실시간 목록/5초 스냅샷에 싣는 미확인 알람 최대 수 (개수 집계는 정확히 유지)
OPEN_ALERTS_CAP=2000

# --- L2 링크 추정 (이슈 #48, 기본 OFF) ---------------------------------------
# true 로 바꾸면 GET /api/topology/inferred (읽기 전용 디버그 API)가 열립니다.
# false(기본)면 이 API는 404 를 돌려주고, 다른 동작은 전혀 바뀌지 않습니다.
# /api/topology 화면 데이터에는 아직 반영하지 않습니다 (3단계에서 추가 예정).
# POST /api/arp (ARP 수집)는 토글과 무관하게 항상 열려 있습니다 (저장만 함).
L2_INFERENCE_ENABLED=false
# MAC 1개가 ARP에서 이 개수보다 많은 IP를 가지면 "가상화 호스트/프록시 ARP"로 표시
L2_VIRT_HOST_MAX_IPS=4
